
\\ Example Run

mzvec(n)={
my(v);
v=vector(n-1);
v[1]=zetamult([n]);
for(k=1,n-2,
v[k+1]=zetamult([n-k,k]);
);
return(v);
};

mzvec_23(n)={
my(v);
v=List();
for(len=1,n\2,
forvec(x=vector(len,i,[2,3]),
if(sum(i=1,len,x[i])==n,
listput(v,zetamult(x));
);
);
);
return(Vec(v));
};

pairwise_products(n)={
my(v,res);
v=mzvec_23(n);
res=List();
for(i=1,#v,
for(j=i,#v,
listput(res,v[i]*v[j]);
);
);
return(Vec(res));
};



\p 1200
v = pairwise_products(10);
Mrel = #v * 10^23;
gm=sqrt(4/3) + 1;
rel = pslqbounded(v, Mrel, 0, gm);

